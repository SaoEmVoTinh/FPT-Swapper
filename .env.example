# ==============================================================================
# 1. PRIVATE KEYS (BẢO MẬT TUYỆT ĐỐI — CHỈ DÙNG Ở SERVER / BACKEND)
#    Không bao giờ gắn tiền tố NEXT_PUBLIC_ hoặc lộ ra trình duyệt / GitHub
# ==============================================================================
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=sb_secret_[YOUR-SUPABASE-SECRET-KEY]
SECRET_KEY=change-me-to-a-random-32-char-hex-secret-key

# Cấu hình nội bộ phía Server (Không tự set BACKEND_URL trên Vercel Dashboard)
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_URL=http://localhost:8001


# ==============================================================================
# 2. PUBLIC KEYS (CÔNG KHAI — AN TOÀN CHO TRÌNH DUYỆT / FRONTEND)
#    Các biến có tiền tố NEXT_PUBLIC_ sẽ được gửi xuống trình duyệt
# ==============================================================================
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_[YOUR-SUPABASE-PUBLISHABLE-KEY]

# Bản sao URL & Publishable Key cho Backend
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=sb_publishable_[YOUR-SUPABASE-PUBLISHABLE-KEY]
